{
	"name": "dimaslz-cv",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prepare": "svelte-kit sync || echo ''",
		"start": "node build",
		"preview": "vite preview --port 2000 --host",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"lint": "oxlint && pnpm run format",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/cookie": "^1.0.0",
		"jsdom": "^30.1.3",
		"oxlint": "^1.93.0",
		"pdf-parse": "^2.4.5",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"type": "module",
	"dependencies": {
		"@lottiefiles/svelte-lottie-player": "^0.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"puppeteer": "^25.17.0"
	}
}
